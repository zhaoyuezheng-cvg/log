baseURL = "https://azlog.org"
languageCode = "zh-CN"
title = "Az日志"
theme = "PaperMod"
paginate = 10
enableRobotsTXT = true
enableEmoji = true

[taxonomies]
category = "categories"
tag = "tags"

[menu]
[[menu.main]]
identifier = "home"
name = "🏠 首页"
url = "/"
weight = 1

[[menu.main]]
identifier = "categories"
name = "📂 分类"
url = "/categories/"
weight = 2

[[menu.main]]
identifier = "tags"
name = "🏷 标签"
url = "/tags/"
weight = 3

[[menu.main]]
identifier = "archives"
name = "📜 归档"
url = "/archives/"
weight = 4

[[menu.main]]
identifier = "about"
name = "👤 关于"
url = "/about/"
weight = 5

[params]
env = "production"
author = "azheng"
description = "个人技术，感悟，关注AI,hugo --minifyHugo + GitHub 博客"
defaultTheme = "auto"
ShowReadingTime = true
ShowPostNavLinks = true
ShowBreadCrumbs = true
ShowCodeCopyButtons = true
ShowWordCount = true
UseHugoToc = true
showToc = true
TocOpen = false

[params.homeInfoParams]
title = "欢迎来到AZ日志"
content = "记录技术与生活"

[[params.socialIcons]]
name = "github"
url = "https://github.com/zhaoyuezheng"

[markup.goldmark.renderer]
unsafe = true