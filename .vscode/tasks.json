{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hugo: New Post",
      "type": "shell",
      "command": "hugo new posts/${input:postName}.md && code content/posts/${input:postName}.md",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Hugo: Build & Deploy",
      "type": "shell",
      "command": "hugo -D && git add . && git commit -m \"Site updated: $(date '+%Y-%m-%d %H:%M:%S')\" && git push",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "postName",
      "type": "promptString",
      "description": "Enter the new post name (e.g., my-first-post)"
    }
  ]
}